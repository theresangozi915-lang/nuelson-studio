self.addEventListener('install', e => {
  e.waitUntil(
    caches.open('nuelson-v1').then(cache => {
      return cache.addAll(['/nuelson-studio/', '/nuelson-studio/index.html']);
    })
  );
});
self.addEventListener('fetch', e => {
  e.respondWith(
    caches.match(e.request).then(res => res || fetch(e.request))
  );
});
